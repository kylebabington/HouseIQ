PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@host:26257/houseiq?sslmode=verify-full

# Must match the frontend's VITE_AUTH0_DOMAIN / VITE_AUTH0_AUDIENCE
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_AUDIENCE="https://api.houseiq.app"

# Origin allowed by CORS (the running frontend). Comma-separate
# multiple origins if needed. In development, localhost Vite ports
# 5173–5179 are also allowed automatically.
FRONTEND_URL="http://localhost:5173"

# Optional: expose one real HouseIQ home through the public read-only demo.
# Use the UUID of a normal home owned by your demo/admin account.
PUBLIC_DEMO_HOME_ID=""

# Optional: Resource Owner Password grant for npm run demo:seed-history.
# The user must own PUBLIC_DEMO_HOME_ID. Prefer HOUSEIQ_ACCESS_TOKEN
# if you already have a bearer token.
# AUTH0_TEST_CLIENT_ID=""
# AUTH0_TEST_CLIENT_SECRET=""
# AUTH0_TEST_USERNAME=""
# AUTH0_TEST_PASSWORD=""
# AUTH0_TEST_REALM="Username-Password-Authentication"
# HOUSEIQ_API_URL="http://localhost:5000"
# DEMO_SEED_TOKEN=""

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL="gpt-4o-mini"

# CockroachDB Cloud Managed MCP (Memory Auditor).
# This is Cloud RBAC, not the SQL user in DATABASE_URL.
# Create a service account (Cluster Admin or Cluster Operator)
# and copy the secret API key once. Cluster ID is in:
# https://cockroachlabs.cloud/cluster/{cluster-id}/overview
COCKROACH_MCP_URL="https://cockroachlabs.cloud/mcp"
COCKROACH_MCP_API_KEY=""
COCKROACH_CLUSTER_ID=""
COCKROACH_MCP_DATABASE="houseiq"

AWS_REGION="us-east-2"
AWS_S3_BUCKET_NAME="your-private-houseiq-document-bucket"

# Local development only.
# Use an IAM role when the application is deployed inside AWS.
AWS_ACCESS_KEY_ID="your-local-access-key-id"
AWS_SECRET_ACCESS_KEY="your-local-secret-access-key"

# NOTE: backend/db/pool.js and backend/db/runSchema.js only use
# `ssl: { rejectUnauthorized: false }` when NODE_ENV is NOT
# "production" (to tolerate local certificate-chain quirks).
# In production, set NODE_ENV=production so the app uses normal
# SSL certificate verification instead.
